# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:3000

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Chat IDs (Get these by messaging @userinfobot or @getidsbot)
KITCHEN_CHAT_ID=your_kitchen_chat_id
BAR_CHAT_ID=your_bar_chat_id
MANAGER_CHAT_ID=your_manager_chat_id

# Staff Authentication PINs (Change these in production!)
STAFF_MANAGER_PIN=0000
STAFF_KITCHEN_PIN=1111
STAFF_BAR_PIN=2222

# Database Configuration (Supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Rate Limiting (100 requests per minute by default)
# RATE_LIMIT_WINDOW=60000
# RATE_LIMIT_MAX=100

# IP Whitelisting for Staff Routes
IP_WHITELIST_ENABLED=false
WHITELISTED_IPS=127.0.0.1,::1,192.168.1.100

# Data Retention (hours) - Default: 24 hours
DATA_RETENTION_HOURS=24

# Optional: JWT Secret for token-based authentication
# JWT_SECRET=your-secret-key-here

LOG_LEVEL=info
